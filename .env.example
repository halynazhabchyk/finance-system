# Root environment of docker compose. Copy to .env and fill in the secrets.
# Secrets are intentionally left empty here.

# --- PostgreSQL (business services) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- LLM (ЛР №4) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_THINKING_LEVEL=

# --- Guardrails of the agents (ЛР №4) ---
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_TOKENS_PER_REQUEST=20000
TOOL_RESULT_MAX_CHARS=4000
USER_MESSAGE_MAX_CHARS=2000
GATEWAY_TIMEOUT_SECONDS=10

# --- MCP server (ЛР №4) ---
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,traefik,traefik:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- A2A agents (ЛР №4) ---
BUDGET_AGENT_PUBLIC_URL=http://localhost:8080/agents/budget
REPORT_AGENT_PUBLIC_URL=http://localhost:8080/agents/report
A2A_SAGA_WAIT_SECONDS=45
A2A_SAGA_POLL_INTERVAL_SECONDS=1
A2A_TIMEOUT_SECONDS=90

# --- Controlled failures for demonstrations (ЛР №3), keep false ---
OUTBOX_SIMULATE_FAILURE=false
REPORT_SIMULATE_FAILURE=false

# --- CORS (ЛР №5): explicit comma-separated origins, "*" is rejected at startup.
# The department site opens over https (http redirects to it); localhost is for development only.
CORS_ALLOWED_ORIGINS=https://cad.kpi.ua,http://cad.kpi.ua,http://localhost:8080

# --- Keycloak (ЛР №5): authorization server and its own PostgreSQL (keycloak-db) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
# Public base address of Keycloak (browser side); the "iss" claim is <base>/realms/finance.
OIDC_PUBLIC_BASE_URL=http://localhost:8080/auth
OIDC_ISSUER=http://localhost:8080/auth/realms/finance
# Keys (JWKS) are fetched inside Docker from the internal address; "iss" is still checked against OIDC_ISSUER.
OIDC_JWKS_URL=http://keycloak:8080/auth/realms/finance/protocol/openid-connect/certs
# OIDC_AUDIENCE is set per service in docker-compose.yml (user-service, budget-service, report-service, ai-assistant).

# --- Google identity provider (Google Cloud Console -> OAuth client, Web application) ---
# Authorized redirect URI: http://localhost:8080/auth/realms/finance/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
