# user_service: copy to .env and fill in the password (never commit .env).
# Database of this service (Database per Service).
USER_DB_NAME=user_service
USER_DB_USER=user_service
USER_DB_PASSWORD=
USER_DB_HOST=postgres

# ЛР №5: token verification. docker-compose.yml sets these; they are listed for running outside Docker.
# OIDC_ISSUER=http://localhost:8080/auth/realms/finance
# OIDC_JWKS_URL=http://localhost:8080/auth/realms/finance/protocol/openid-connect/certs
# OIDC_AUDIENCE=user-service
# CORS_ALLOWED_ORIGINS=https://cad.kpi.ua,http://cad.kpi.ua,http://localhost:8080
# JWT_SECRET_KEY is no longer used: tokens are RS256, issued by Keycloak.
